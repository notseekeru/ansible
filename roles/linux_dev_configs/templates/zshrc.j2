export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="lukerandall"

plugins=(
    git
    sudo
    history
    web-search
)

source "$ZSH/oh-my-zsh.sh"
source "$ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export LC_CTYPE=en_US.UTF-8

# BEGIN ANSIBLE MANAGED BLOCK: bob_nvim
export PATH="$HOME/.local/share/bob/nvim-bin:$HOME/.local/bin:$PATH"
# END ANSIBLE MANAGED BLOCK: bob_nvim

alias ls='ls --color=auto'
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias compose='docker compose'
alias lg='lazygit'

aga() {
    cd ~/agents/arciero-agent
}

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Added by Antigravity CLI installer
export PATH="/home/seeker/.local/bin:$PATH"

unalias gcm 2>/dev/null

gcm() {
    git add -A
    local git_diff=$(git diff --cached | tr '\n' ' ')
    local msg=$(echo "Output ONLY a single conventional commit subject with scope ≤60 chars. No preamble, no markdown, no explanation. Diff: $git_diff" | pi --provider deepseek --model deepseek-v4-flash 2>/dev/null | tr -d '`' | grep -oP '^[a-z]+(?:\([^)]*\))?!?:? .*' | head -1)

    if [ -n "$msg" ]; then
        git commit -m "$msg"
    else
        echo "Error: Could not generate a valid conventional commit message."
        return 1
    fi
}
