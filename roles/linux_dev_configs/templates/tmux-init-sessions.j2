#!/usr/bin/env bash
set -euo pipefail

create_session() {
  local name="$1" dir="$2"
  shift 2

  if tmux has-session -t "$name" 2>/dev/null; then
    local win_count win_name
    win_count=$(tmux list-windows -t "$name" -F '#{window_name}' 2>/dev/null | wc -l)
    win_name=$(tmux list-windows -t "$name" -F '#{window_name}' 2>/dev/null | head -1)
    if [ "$win_count" -eq 1 ] && [ "$win_name" = "zsh" ]; then
      tmux kill-session -t "$name"
    else
      return 0
    fi
  fi

  tmux new-session -d -s "$name" -c "$dir" -n "$1"
  shift
  for win in "$@"; do
    tmux new-window -t "$name:" -c "$dir" -n "$win"
  done
}

{% for session in linux_dev_configs_tmux_sessions %}
create_session {{ session.name }} {{ session.dir }} {{ session.windows | join(' ') }}
{% endfor %}
